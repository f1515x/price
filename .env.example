# Gate credentials are fetched only from Infisical, never from API_KEY/API_SECRET here.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
# Existing INFISICAL_ENVIRONMENT is an alias; INFISICAL_ENV wins in the same source.
# Optional: EU cloud or your self-hosted service (use HTTPS in production).
INFISICAL_URL=https://us.infisical.com
INFISICAL_SECRET_PATH=/

# Telegram supports process environment and the root .env.
TELEGRAM_BOT_TOKEN=

# Supabase project URL, without the table path.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=
SUPABASE_TABLE=orders
# Optional logged-in user JWT.
SUPABASE_ACCESS_TOKEN=
# Legacy Python supabase(data=None) fallback; CLI defaults to reports/sizes.txt.
SUPABASE_TEST_DATA={}
