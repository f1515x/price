# Gate credentials are read exclusively from Supabase secret, never from this file.
# Telegram currently reads this value from the process environment.
TELEGRAM_BOT_TOKEN=

# Supabase project URL, without the table path.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=
SUPABASE_TABLE=orders
# Optional logged-in user JWT.
SUPABASE_ACCESS_TOKEN=
# Legacy Python supabase(data=None) fallback; CLI defaults to reports/sizes.txt.
SUPABASE_TEST_DATA={}
